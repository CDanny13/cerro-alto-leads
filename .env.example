# Copia este archivo como .env y completa los valores. Nunca subas tu .env.
# La URL y el token de la API de pacientes aparecen en la página de la prueba.
API_PACIENTES_URL=
API_PACIENTES_TOKEN=
# La key del LLM que uses para clasificar.
LLM_API_KEY=
# URL COMPLETA del endpoint chat/completions; compatible con distintos proveedores.
# Ollama local real: http://localhost:11434/v1/chat/completions, key=ollama.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_URL=
LLM_MODEL=
# false si el proveedor no admite response_format; la validación local sigue activa.
LLM_JSON_MODE=true
# auto usa max_completion_tokens en api.openai.com y max_tokens en otros proveedores.
# Puedes fijar max_tokens o max_completion_tokens según la documentación del proveedor.
LLM_TOKEN_PARAMETER=auto

# Webhook que reciba {"text":"..."}; compatible con Slack Incoming Webhooks.
# Debe llegar a una persona. La URL puede ser un secreto: no publicarla.
# Pasos para crear la app, autorizar el canal y probar el envío: sección Slack del README.
ALERT_WEBHOOK_URL=
# Opcional si el receptor usa Bearer. Con Slack Incoming Webhooks déjalo vacío.
ALERT_WEBHOOK_TOKEN=
# Token independiente para revisión y reprocesamiento; genera uno ASCII aleatorio.
# Comando e instrucciones en README.md. Reinicia la app después de configurarlo.
ADMIN_TOKEN=

DB_PATH=data/leads.sqlite3
WORKER_ENABLED=true
POLL_SECONDS=0.5
REQUEST_TIMEOUT=15
MAX_ATTEMPTS=3
RETRY_SECONDS=5
LEASE_SECONDS=240
DEDUPE_HOURS=24
MAX_BODY_BYTES=262144
MAX_MESSAGE_CHARS=30000

# Feriados observados nacionales (incluidos traslados), separados por coma.
# Ejemplo de FORMATO, no de calendario: AAAA-MM-DD,AAAA-MM-DD.
NATIONAL_HOLIDAYS=
# Activar solo después de completar el calendario del período de operación.
# Mientras sea false se preparan instrucciones condicionales de urgencia.
HOLIDAYS_COMPLETE=false
